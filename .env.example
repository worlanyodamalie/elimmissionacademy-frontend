# --- Public configuration (exposed to the browser) ---

# Base path the browser uses to call the API. By default we use a same-origin
# proxy (`/api/proxy`) so the browser never makes a cross-origin request.
# This avoids CORS issues with the backend in local development.
#
# If your backend already returns CORS headers for your origin, you can point
# this directly at the backend (e.g. https://api.example.com/api/v1) and stop
# using the proxy.
NEXT_PUBLIC_API_BASE_URL=/api/proxy

# Optional: human-readable application name shown in the UI.
NEXT_PUBLIC_APP_NAME="Elim Mission Academy"

# --- Server-only configuration (never sent to the browser) ---

# The real backend URL the proxy at /api/proxy forwards to.
# Required when NEXT_PUBLIC_API_BASE_URL is /api/proxy (the default).
BACKEND_API_BASE_URL=https://school-management-system-application.onrender.com/api/v1
https://school-management-system-application.onrender.com/api/v1/auth/school/admin/setup?token=b3f01a92-3c83-4711-ab09-9781c6756d77&schoolCode=WOR_49745