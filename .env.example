# --- Public configuration (exposed to the browser) ---

# Base URL the browser uses for API calls. Point this at the backend's
# /api/v1 root. The backend must allow your origin in its CORS config.
NEXT_PUBLIC_BACKEND_API_BASE_URL=https://school-management-system-application.onrender.com/api/v1

# Optional: human-readable application name shown in the UI.
NEXT_PUBLIC_APP_NAME="Elim Mission Academy"
